---
// Blog listing page
// ------------
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Eyebrow from '../../components/ui/Eyebrow.astro'
import Card from '../../components/ui/cards/partials/Card.astro'
import { getCollection } from 'astro:content'
import LaptopFrame from '../../components/ui/LaptopFrame.astro'
import { Icon } from 'astro-icon/components'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })

const SEO = {
	title: 'Blog | Revolt Energy',
	description:
		'Grid intelligence, regulatory developments and practical insights for BESS developers and investors in Germany.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Section id="blog-hero" mode="light" surfaceColor padding="top">
		<div class="mx-auto max-w-3xl pb-4 text-center">
			<Eyebrow title="Blog" />
			<h1 class="mb-6 font-headings text-3xl font-bold leading-tight text-neutral-700 lg:text-4xl">
				Grid insights
			</h1>
			<p class="text-lg leading-relaxed text-neutral-600">
				Grid intelligence, regulatory developments and practical insights for BESS developers and
				investors in Germany.
			</p>
		</div>
	</Section>
	<Section id="blog-list" mode="light" surfaceColor>
		<div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-3">
			{
				posts.map((post) => (
					<Card classes="h-full">
						<a href={`/blog/${post.id}/`} class="flex h-full flex-col !text-inherit">
							{post.data.heroImage && (
								<div class="flex h-48 items-end justify-center overflow-hidden rounded-t bg-primary-50 px-10 pt-6">
									<LaptopFrame
										src={post.data.heroImage}
										alt={post.data.heroImageAlt ?? post.data.title}
										classes="translate-y-2"
									/>
								</div>
							)}
							<div class="flex flex-1 flex-col p-8">
								<p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary-500">
									{post.data.category} · {formatDate(post.data.pubDate)}
								</p>
								<h2 class="mb-4 font-headings text-xl font-bold leading-snug text-neutral-800">
									{post.data.title}
								</h2>
								<p class="mb-6 flex-1 text-sm leading-relaxed text-neutral-600">
									{post.data.description}
								</p>
								<span class="flex items-center text-sm font-bold uppercase tracking-wide text-neutral-800">
									Read article
									<Icon name="arrow-right" class="ml-2" />
								</span>
							</div>
						</a>
					</Card>
				))
			}
		</div>
		{
			posts.length === 0 && (
				<p class="text-center text-neutral-500">Articles coming soon.</p>
			)
		}
	</Section>
</Layout>
