---
// Components
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
import { Icon } from 'astro-icon/components'
import Button from '../components/ui/Button.astro'
import InputField from '../components/ui/forms/form-elements/InputField.astro'
import DropdownField from '../components/ui/forms/form-elements/DropdownField.astro'
import CheckboxField from '../components/ui/forms/form-elements/CheckboxField.astro'
import TextArea from '../components/ui/forms/form-elements/TextArea.astro'

const SEO = {
	title: 'Contact Us | Revolt Energy',
	description:
		'Connect with the Revolt technical team for GridScore™ analytics or strategic advisory for BESS deployment.'
}

const dropdownOptions = [
	{ value: 'GridScore demo', label: 'GridScore demo' },
	{ value: 'Grid advisory / project assessment', label: 'Grid advisory / project assessment' },
	{ value: 'Other', label: 'Other' }
]
---

<Layout title={SEO.title} description={SEO.description}>
	<Section id="contact-form" mode="light" surfaceColor>
		<Row classes="gap-y-16">
			<Col span="5">
				<h2 class="mb-8 font-headings text-3xl font-bold leading-tight lg:text-4xl">
					GET IN TOUCH
				</h2>
				<p class="mb-6 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
					Get in touch to discuss GridScore, project-specific assessments, or strategic grid
					advisory.
				</p>
				<p class="mb-10 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
					We're a multilingual team — all of us speak English and German fluently, so reach out in
					whichever you prefer.
				</p>
				<div
					class="divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800"
				>
					<a href="mailto:info@revoltgrid.de" class="group flex items-start gap-5 py-5">
						<Icon name="document-chart-bar" class="h-5 w-5 shrink-0 text-primary-500" />
						<div class="min-w-0">
							<p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
								GridScore demo or Grid Advisory
							</p>
							<p class="font-mono text-sm font-semibold text-primary-500 transition-colors group-hover:text-primary-700">
								info@revoltgrid.de
							</p>
						</div>
					</a>
					<a href="mailto:contact@revoltgrid.de" class="group flex items-start gap-5 py-5">
						<Icon name="chat-bubble-left-right" class="h-5 w-5 shrink-0 text-primary-500" />
						<div class="min-w-0">
							<p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
								Partnerships and platform support
							</p>
							<p class="font-mono text-sm font-semibold text-primary-500 transition-colors group-hover:text-primary-700">
								contact@revoltgrid.de
							</p>
						</div>
					</a>
				</div>
				<div class="mt-8">
					<Button size="lg" style="accent-light" link="https://cal.com/revoltenergy/introcall">
						Book a Call
						<Icon name="arrow-right" class="ml-2 h-4 w-4" />
					</Button>
				</div>
				<div
					class="mt-12 flex items-center gap-3 text-sm font-medium text-neutral-600 dark:text-neutral-300"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						class="h-5 w-5 shrink-0 text-primary-500"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
						></path>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
						></path>
					</svg>
					<span>Berlin, Germany</span>
				</div>
			</Col>
			<Col span="6" classes="lg:col-start-7">
				<div
					class="border border-neutral-200 bg-white p-8 shadow-sm lg:p-12 dark:border-neutral-800 dark:bg-neutral-950"
				>
					<div data-fs-success class="mb-6 font-headings text-lg font-bold text-primary-500"></div>
					<div data-fs-error class="mb-6 text-red-500"></div>

					<form id="fs-contact-form" class="space-y-6">
						<InputField id="name" label="Full Name" type="text" data-fs-field required />
						<InputField id="email" label="Work Email" type="email" data-fs-field required />
						<InputField
							id="company"
							label="Company / Organization"
							type="text"
							data-fs-field
							required
						/>
						<DropdownField
							id="interested"
							label="What are you interested in?"
							options={dropdownOptions}
							data-fs-field
						/>
						<TextArea id="message" label="Message" data-fs-field required />
						<CheckboxField
							id="consent"
							label="I agree to the privacy policy."
							data-fs-field
							required
						/>
						<input
							type="hidden"
							name="g-recaptcha-response"
							id="g-recaptcha-response"
							data-fs-field
						/>
						<Button
							style="accent-light"
							size="lg"
							type="submit"
							classes="w-full"
							data-fs-submit-btn
						>
							SEND INQUIRY
							<Icon name="arrow-right" class="ml-2 h-4 w-4" />
						</Button>
					</form>
				</div>
			</Col>
		</Row>
	</Section>
	<script is:inline>
		// This runs on the initial load AND every time you switch pages asynchronously
		document.addEventListener('astro:page-load', () => {
			const form = document.getElementById('fs-contact-form')

			// Exit immediately if the user navigated to a page without the form
			if (!form) return

			// A. Restore the Google reCAPTCHA Badge cleanly
			// If the badge got wiped by the page transition, re-inject the script
			if (!document.querySelector('.grecaptcha-badge')) {
				const script = document.createElement('script')
				script.src =
					'https://www.google.com/recaptcha/api.js?render=6LfeH_EsAAAAAN97gCRIAq_znfgU_z8VFhAzdFNO'
				document.body.appendChild(script)
			}

			// B. Re-attach the Form Interceptor to the new DOM element
			form.addEventListener('submit', function (e) {
				const recaptchaInput = document.getElementById('g-recaptcha-response')
				const submitBtn = form.querySelector('[data-fs-submit-btn]')

				if (!recaptchaInput.value) {
					e.preventDefault()
					e.stopImmediatePropagation()

					if (submitBtn) submitBtn.disabled = true

					grecaptcha.ready(function () {
						grecaptcha
							.execute('6LfeH_EsAAAAAN97gCRIAq_znfgU_z8VFhAzdFNO', { action: 'submit' })
							.then(function (token) {
								recaptchaInput.value = token
								if (submitBtn) submitBtn.disabled = false
								form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }))
							})
					})
				}
			})

			// C. Re-initialize Formspree on the new form element
			window.formspree =
				window.formspree ||
				function () {
					;(formspree.q = formspree.q || []).push(arguments)
				}
			formspree('initForm', { formElement: '#fs-contact-form', formId: 'mbdbjepv' })
		})
	</script>
	<script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>
</Layout>
