---
import Layout from '../layouts/Layout.astro'

import GridScoreHero from '../components/sections/gridscore/GridScoreHero.astro'
import GridScoreMetrics from '../components/sections/gridscore/GridScoreMetrics.astro'
import GridScoreCapabilities from '../components/sections/gridscore/GridScoreCapabilities.astro'
import GridScoreSupport from '../components/sections/gridscore/GridScoreSupport.astro'
import GridScoreFaq from '../components/sections/gridscore/GridScoreFaq.astro'
import CTA from '../components/blocks/homepage/CTA.astro'

const SEO = {
	title: 'GridScore™ — Grid Intelligence Workspace | Revolt Energy',
	description:
		'GridScore™ helps BESS developers and investors screen, compare and prioritize grid connection opportunities across Germany — capacity signals, congestion exposure, network build-out and process timing in one workspace.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<GridScoreHero />
	<GridScoreMetrics />
	<GridScoreCapabilities />
	<GridScoreSupport />
	<GridScoreFaq />
	<CTA classes="!bg-white" />
</Layout>
