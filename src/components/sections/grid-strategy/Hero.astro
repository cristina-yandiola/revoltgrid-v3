---
import SectionWithImage from '../../../components/ui/SectionWithImage.astro'
import Button from '../../../components/ui/Button.astro'
import Col from '../../../components/ui/Col.astro'
import Row from '../../../components/ui/Row.astro'
import pylonsImage from '../../../assets/aerial-powerlines.jpg'
---

<SectionWithImage
	id="strategy-hero"
	image={pylonsImage}
	imageAlt="Aerial view of high-voltage transmission lines crossing the German countryside"
	mode="light"
	surfaceColor
	imageClasses="grayscale-[0.2] contrast-[1.05] !object-top"
>
	<Row classes="items-center">
		<Col span="12" classes="relative z-10">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				Specialist Grid Advisory
			</p>
			<h1 class="mb-6 font-headings text-3xl font-bold leading-tight lg:text-4xl">Grid Advisory</h1>
			<p class="mb-10 max-w-xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
				Project-specific grid intelligence and strategic advisory for developers and investors
				navigating Germany's evolving grid landscape.
			</p>
			<div class="flex flex-wrap gap-4">
				<Button size="lg" style="accent-light" link="/contact">Book a Call</Button>
				<Button size="lg" style="neutral" variation="outline" link="/gridscore"
					>View GridScore</Button
				>
			</div>
		</Col>
	</Row>
</SectionWithImage>
