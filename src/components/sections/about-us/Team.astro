---
// Team — founder section
// NOTE for Cristina: bio copy below uses only claims already on the site
// (decade+ in European energy infrastructure, 1GW+ connected). Adjust wording,
// add a photo and a LinkedIn URL before go-live if you want them shown.
import Section from '../../ui/Section.astro'
import Col from '../../ui/Col.astro'
import Row from '../../ui/Row.astro'
---

<Section id="team" mode="light" surfaceColor>
	<Row classes="mb-12 text-center">
		<Col span="8" classes="lg:col-start-3">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				Team
			</p>
			<h2 class="font-headings text-3xl font-bold leading-tight lg:text-4xl">Who you work with</h2>
		</Col>
	</Row>
	<Row>
		<Col span="8" classes="lg:col-start-3">
			<div class="rounded-lg bg-primary-50 p-10 text-center">
				<p class="mb-1 font-headings text-2xl font-bold text-neutral-800">Cristina Mata Yandiola</p>
				<p class="mb-6 font-mono text-xs font-bold uppercase tracking-[0.18em] text-primary-700">
					Founder
				</p>
				<p class="mx-auto mb-0 max-w-xl leading-relaxed text-neutral-600">
					Revolt was founded by Cristina Mata Yandiola after more than a decade in European energy
					infrastructure, with over 1 GW of projects connected. Every engagement is led by senior
					grid expertise — supported by Revolt's analytics and a growing team.
				</p>
			</div>
		</Col>
	</Row>
</Section>
