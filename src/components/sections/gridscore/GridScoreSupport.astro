---
import SectionWithImage from '../../ui/SectionWithImage.astro'
import Col from '../../../components/ui/Col.astro'
import Row from '../../../components/ui/Row.astro'
import energySafeWork from '../../../assets/panels-2.jpg'

const supportItems = [
	{
		title: 'Grid risk assessment',
		text: 'Independent, project-specific analysis of congestion, curtailment and network constraints affecting a site.'
	},
	{
		title: 'Connection strategy & process support',
		text: 'Guidance through TSO and DSO application processes, Reifegradverfahren and connection negotiations.'
	},
	{
		title: 'Acquisition & pipeline screening',
		text: 'Early-stage support for project selection, portfolio prioritization, and grid-related development risk.'
	}
]
---

<SectionWithImage
	id="gridscore-hero"
	image={energySafeWork}
	imageAlt="A futuristic power line tower silhouetted against a sharp sunset sky, geometric patterns of steel wires and glass insulators"
	mode="light"
>
	<Row>
		<Col span="10" classes="relative z-10">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				Beyond the Score
			</p>
			<h2 class="mb-8 font-headings text-3xl font-bold leading-tight lg:text-4xl">
				When a project needs more than a score
			</h2>
			<p class="mb-8 leading-relaxed text-neutral-600">
				GridScore supports screening and prioritization. For investment decisions, project-specific
				assessments or complex connection questions, Revolt provides independent analysis and
				specialist <a href="/grid-strategy" class="font-semibold">grid advisory</a>.
			</p>
			<div class="space-y-12">
				{
					supportItems.map((item) => (
						<div class="rounded-lg bg-primary-50 p-6">
							<h3 class="mb-2 font-bold">{item.title}</h3>
							<p class="text-neutral-600 dark:text-neutral-400">{item.text}</p>
						</div>
					))
				}
			</div>
		</Col>
	</Row>
</SectionWithImage>
