---
import SectionWithImage from '../../ui/SectionWithImage.astro'
import Col from '../../../components/ui/Col.astro'
import Row from '../../../components/ui/Row.astro'
import gridMap from '../../../assets/product-grid-map.jpg'
import Button from '../../ui/Button.astro'
import { Icon } from 'astro-icon/components'
---

<SectionWithImage
	id="gridscore-hero"
	image={gridMap}
	imageAlt="Revolt Grid Workspace — Germany-wide grid map with 380, 220 and 110 kV layers and substations"
	mode="light"
	surfaceColor
	classes="min-h-[600px]"
>
	<Row>
		<Col span="12" classes="relative z-10">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				Grid Intelligence Workspace
			</p>
			<h1 class="mb-6 font-headings text-5xl font-bold leading-tight lg:text-4xl">GridScore™</h1>
			<p class="mb-10 max-w-xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
				Screen, compare and prioritize grid connection opportunities across Germany — grid
				constraints, curtailment exposure, network build-out and connection timing in one
				workspace.
			</p>
			<div class="flex flex-wrap items-center gap-6">
				<Button size="lg" link="/book" style="accent-light">Book a demo</Button>
				<Button variation="link" style="neutral" size="lg" link="#gridscore-capabilities">
					<span
						class="flex items-center border-b-2 border-neutral-500 px-0.5 pb-1 font-bold uppercase transition-colors duration-200 hover:text-primary-700"
					>
						See what's inside
						<Icon name="arrow-right" class="ml-2" />
					</span>
				</Button>
			</div>
		</Col>
	</Row>
</SectionWithImage>
