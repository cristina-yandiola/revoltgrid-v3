---
// GridScore FAQ — honest answers to the questions prospects actually ask
import Section from '../../ui/Section.astro'
import Col from '../../ui/Col.astro'
import Row from '../../ui/Row.astro'

const faqs = [
	{
		q: 'Where does the data come from?',
		a: "Exclusively from official, publicly accessible sources: redispatch measure lists from Netztransparenz.de at TSO level and official DSO publications at distribution level; the Marktstammdatenregister (Bundesnetzagentur) for plants and grid connection points; the Netzentwicklungsplan project library (netzentwicklungsplan.de) and BNetzA's netzausbau.de monitoring for grid build-out; the grid operators' published connection-capacity indications; and SMARD and Regelleistung.net market data for revenue context. Grid mapping builds on OpenStreetMap data (© OpenStreetMap contributors). Every figure in the workspace traces to its source."
	},
	{
		q: 'Does GridScore guarantee grid capacity at a substation?',
		a: 'No. GridScore supports early-stage screening and prioritization. Binding capacity confirmations only come from the relevant grid operator through the formal connection process; GridScore helps you decide where that process is worth starting.'
	},
	{
		q: 'What does GridScore cover?',
		a: "Germany's 380 kV transmission network across all four TSO regions, with progressive expansion into the 110 kV distribution grid. The availability and precision of individual indicators depend on what the relevant grid operators publish."
	},
	{
		q: 'Who is it for?',
		a: 'BESS developers and investors managing multiple development opportunities — screening new sites, prioritizing an existing pipeline, or evaluating projects for acquisition.'
	},
	{
		q: 'Can Revolt look at a specific project in depth?',
		a: 'Yes. Project-specific grid risk assessments, connection reviews and strategic support are available through Grid Advisory, independently of a GridScore subscription.'
	}
]
---

<Section id="gridscore-faq" mode="light" classes="!bg-white !pt-4 lg:!pt-8">
	<Row>
		<Col span="8" classes="lg:col-start-3">
			<p class="mb-4 text-center font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				FAQ
			</p>
			<h2 class="mb-10 text-center font-headings text-3xl font-bold leading-tight lg:text-4xl">
				Common questions
			</h2>
			<div class="space-y-4">
				{
					faqs.map((faq) => (
						<details class="group rounded-lg bg-surface-50 p-6">
							<summary class="cursor-pointer list-none font-bold text-neutral-700 marker:hidden [&::-webkit-details-marker]:hidden">
								<span class="flex items-center justify-between gap-4">
									{faq.q}
									<span class="text-primary-500 transition-transform duration-200 group-open:rotate-45">
										+
									</span>
								</span>
							</summary>
							<p class="mt-4 mb-0 leading-relaxed text-neutral-600">{faq.a}</p>
						</details>
					))
				}
			</div>
		</Col>
	</Row>
</Section>
