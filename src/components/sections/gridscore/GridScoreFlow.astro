---
// How to start with GridScore + coverage honesty
import Col from '../../ui/Col.astro'
import Row from '../../ui/Row.astro'
import Section from '../../ui/Section.astro'

const steps = [
	{
		number: '1',
		title: 'Book a demo',
		text: 'A short call to understand your pipeline and show you the workspace on real German grid data.'
	},
	{
		number: '2',
		title: 'See it on your own pipeline',
		text: 'We walk through your candidate sites or regions of interest in GridScore, so you can judge the value on your own projects.'
	},
	{
		number: '3',
		title: 'Activate access',
		text: 'Subscription access for your team. Scope depends on the modules and voltage levels you need — discussed in the demo.'
	}
]
---

<Section id="gridscore-flow" mode="light">
	<Row classes="mb-12 text-center">
		<Col span="8" classes="lg:col-start-3">
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-500">
				How to start
			</p>
			<h2 class="font-headings text-3xl font-bold leading-tight lg:text-4xl">
				See GridScore on your own development pipeline
			</h2>
		</Col>
	</Row>

	<Row classes="gap-y-6">
		{
			steps.map((step) => (
				<Col span="4">
					<div class="h-full rounded-lg border-2 border-neutral-200 bg-surface-50 p-8">
						<div class="mb-6 flex h-10 w-10 items-center justify-center rounded bg-primary-500 font-mono text-sm font-bold text-white">
							{step.number}
						</div>
						<h3 class="mb-4 font-headings text-xl font-bold">{step.title}</h3>
						<p class="leading-relaxed text-neutral-600 dark:text-neutral-400">{step.text}</p>
					</div>
				</Col>
			))
		}
	</Row>

	<Row classes="mt-12">
		<Col span="8" classes="lg:col-start-3">
			<div class="rounded-lg bg-primary-50 p-6 text-center">
				<p class="mb-0 text-sm leading-relaxed text-neutral-700">
					<span class="font-bold">Coverage:</span> GridScore launches with Germany's 380 kV
					transmission network and is expanding progressively into the 110 kV distribution grid,
					operator by operator. The availability and precision of individual indicators depend on
					the information published by the relevant grid operators.
				</p>
			</div>
		</Col>
	</Row>
</Section>
