---
// Challenges Section — the problem: capacity alone doesn't tell the whole story
// ------------
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import Eyebrow from '../../ui/Eyebrow.astro'

const stats = [
	{ value: '4.3k', label: 'Substations in the workspace' },
	{ value: '12GW+', label: 'Projects analyzed' }
]
---

<Section id="challenges" classes="bg-surface-100" surfaceColor>
	<Row classes="items-start gap-y-10">
		<Col span="4">
			<Eyebrow title="The Problem" />
			<h2
				class="max-w-sm font-headings text-3xl font-bold leading-tight text-neutral-700 lg:text-4xl"
			>
				Available grid capacity doesn't tell the whole story
			</h2>
		</Col>
		<Col span="6" classes="lg:col-start-7">
			<div class="max-w-2xl">
				<p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
					A substation that looks attractive on paper can hide congestion exposure, slow
					reinforcement timelines, or an application process that is already crowded.
				</p>
				<p class="text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
					Connection opportunities need to be read in context — network constraints, curtailment
					history, planned build-out and the operator's own process — before capital and
					application fees are committed.
				</p>

				<div class="mt-8 border-t border-primary-600 pt-8">
					<div class="grid gap-8 sm:grid-cols-2">
						{
							stats.map((stat) => (
								<div>
									<p class="mb-1 font-headings text-4xl font-bold tracking-tight text-neutral-800">
										{stat.value}
									</p>
									<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-primary-700">
										{stat.label}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</Col>
	</Row>
</Section>
