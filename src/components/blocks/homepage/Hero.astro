---
// Hero Section — company-led: Revolt = grid intelligence + advisory
// ------------
import SectionWithImage from '../../ui/SectionWithImage.astro'
import Button from '../../ui/Button.astro'
import heroImage from '../../../assets/home-hero.jpeg'
import Eyebrow from '../../ui/Eyebrow.astro'
import { Icon } from 'astro-icon/components'
---

<SectionWithImage
	id="hero"
	image={heroImage}
	imageAlt="Technical aerial view of a large scale battery energy storage system facility with white containers and power transformers under clear daylight"
	surfaceColor
	mode="light"
	fullHeight
	imageClasses="grayscale-[0.2] contrast-[1.1]"
>
	<div class="relative z-10 flex flex-col justify-center">
		<Eyebrow title="Revolt Energy · Grid Intelligence" />
		<h1 class="mb-8 font-headings text-3xl font-bold leading-tight lg:text-4xl">
			Find better grid connection opportunities. <span class="marker-highlight">Faster.</span>
		</h1>
		<p class="mb-3 max-w-xl text-lg leading-relaxed text-neutral-600">
			Revolt combines grid intelligence software and specialist advisory to help BESS developers
			and investors in Germany screen connection opportunities, assess grid risk, and navigate the
			connection process.
		</p>
		<p class="mb-10 max-w-xl text-lg leading-relaxed text-neutral-600">
			Behind both sits a proprietary, Germany-wide grid database — built from official sources,
			traceable to every figure.
		</p>
		<div class="flex flex-wrap items-center gap-6">
			<Button size="lg" link="/book" style="accent-light">Book a demo</Button>
			<Button variation="link" style="neutral" size="lg" link="/gridscore">
				<span
					class="flex items-center border-b-2 border-neutral-500 px-0.5 pb-1 font-bold uppercase transition-colors duration-200 hover:text-primary-700"
				>
					Explore GridScore
					<Icon name="arrow-right" class="ml-2" />
				</span>
			</Button>
		</div>
		<p class="mt-8 text-sm text-neutral-500">
			Looking at a specific project? <a
				href="/grid-strategy"
				class="font-semibold text-primary-600 hover:text-primary-700">Explore Grid Advisory →</a
			>
		</p>
	</div>
</SectionWithImage>
