---
// Why Revolt — the substance strip on pale petrol
// ------------
import Section from '../../ui/Section.astro'
import Eyebrow from '../../ui/Eyebrow.astro'
---

<Section id="why-revolt" mode="light" classes="!bg-primary-50">
	<div class="mx-auto max-w-3xl text-center">
		<Eyebrow title="Why Revolt" />
		<h2 class="mb-6 font-headings text-3xl font-bold leading-tight text-neutral-700 lg:text-4xl">
			Built around the grid. Not just another map.
		</h2>
		<p class="text-lg leading-relaxed text-neutral-600">
			Behind the workspace sits a proprietary, Germany-wide grid database: substations, lines and
			connected assets across voltage levels, multi-year congestion history and planned expansion
			from official sources. Every figure in our work traces to its source.
		</p>
	</div>
</Section>
