---
// What Revolt Delivers — three product cards
// ------------
// Uses the site's original Section, Eyebrow, Card and Button components (no custom styles).
import Section from '../../ui/Section.astro'
import Eyebrow from '../../ui/Eyebrow.astro'
import Card from '../../ui/cards/partials/Card.astro'
import Button from '../../ui/Button.astro'

type CardData = {
	tag: string
	title: string
	description: string
	receive: string[]
	usedFor: string
	ctaText: string
	ctaLink: string
}

const cards: CardData[] = [
	{
		tag: 'GridScore Report',
		title: 'Project-based grid risk assessment',
		description:
			'For a named substation and BESS spec — quantifies congestion exposure, FCA probability, and revenue at risk. Ready for investment committees and lenders.',
		receive: [
			'P50/P90 revenue at risk (€/MW/yr)',
			'Redispatch hours & FCA probability rating',
			'BKZ connection cost range',
			'Full market stack breakdown (FCR, aFRR, DA/ID)'
		],
		usedFor: 'investment due diligence, M&A, FCA negotiation prep, bankability assessment',
		ctaText: 'Request Report',
		ctaLink: '#contact'
	},
	{
		tag: 'GridScore Ranking',
		title: 'Germany-wide substation scoring',
		description:
			'Top 100 German 380kV substations ranked by BESS siting attractiveness. Screen your pipeline before committing to site-level analysis.',
		receive: [
			'Top 100 substations ranked 0–100',
			'Congestion scores & BKZ cost ranges',
			'Revenue signal by connection point',
			'All 4 TSO regions covered'
		],
		usedFor: 'pipeline screening, pre-FID siting, acquisition target ranking',
		ctaText: 'Request Ranking',
		ctaLink: '#contact'
	},
	{
		tag: 'Grid Strategy Advisory',
		title: 'Expert support on grid processes',
		description:
			'Hands-on advisory for TSO/DSO negotiations, Reifegradverfahren, FCA structuring, and regulatory positioning across Germany.',
		receive: [
			'TSO/DSO negotiation support',
			'Reifegradverfahren preparation',
			'FCA strategy & structuring',
			'Regulatory framework guidance'
		],
		usedFor: 'connection applications, FCA negotiations, Reifegradverfahren, M&A grid risk',
		ctaText: 'Book a Call',
		ctaLink: 'https://cal.com/revoltenergy/introcall'
	}
]
---

<Section id="delivers" mode="light" surfaceColor>
	<div class="mx-auto mb-14 max-w-2xl text-center">
		<h2 class="font-headings text-3xl font-bold leading-tight text-neutral-700 lg:text-4xl">
			How we support your grid decisions
		</h2>
	</div>

	<div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-3">
		{
			cards.map((card) => (
				<Card classes="h-full">
					<div class="flex h-full flex-col p-8">
						<Eyebrow title={card.tag} />
						<h3 class="mb-4 font-headings text-[26px] font-bold leading-snug text-neutral-800">
							{card.title}
						</h3>
						<p class="mb-6 leading-relaxed text-neutral-600">{card.description}</p>

						<p class="mb-3 text-sm font-bold uppercase tracking-wider text-neutral-700">
							You receive
						</p>
						<ul class="mb-6 ml-5 list-disc space-y-2 marker:text-accent-500">
							{card.receive.map((item) => (
								<li class="pl-1 text-sm leading-relaxed text-neutral-600">{item}</li>
							))}
						</ul>

						<p class="mb-8 text-sm leading-relaxed text-neutral-500">
							<span class="font-semibold text-neutral-700">Used for:</span> {card.usedFor}
						</p>

						<div class="mt-auto flex justify-center pt-2">
							<Button size="lg" style="accent-light" link={card.ctaLink}>
								{card.ctaText}
							</Button>
						</div>
					</div>
				</Card>
			))
		}
	</div>
</Section>
